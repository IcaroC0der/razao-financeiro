# Banco de dados PostgreSQL (Neon ou Vercel Postgres)
POSTGRES_URL="postgres://user:password@host/neondb?sslmode=require"
POSTGRES_PRISMA_URL="postgres://user:password@host/neondb?sslmode=require"
POSTGRES_URL_NON_POOLING="postgres://user:password@host/neondb?sslmode=require"
POSTGRES_USER="user"
POSTGRES_HOST="host"
POSTGRES_PASSWORD="password"
POSTGRES_DATABASE="neondb"

# Segredo para assinatura de tokens JWT da sessão (mínimo 32 caracteres)
# Exemplo: razao_jwt_secret_super_seguro_e_aleatorio_123456
AUTH_SECRET=""
